# Updated get_weapon_walk_sprite_path function
# Tries exact filename first (for glowswords), then falls back to weapon_type mapping

func get_weapon_walk_sprite_path() -> String:
	"""Get the walk sprite path for the currently equipped weapon"""
	if not CharacterStats.equipped_weapon:
		return ""  # Unarmed - no weapon sprite

	var weapon_type = CharacterStats.equipped_weapon.weapon_type

	# FIRST: Try to derive sprite name from the actual sprite_path (for unique weapons like glowswords)
	var slash_sprite_path = CharacterStats.equipped_weapon.sprite_path  # e.g., "res://assets/weapons/glowsword_blue.png"
	var sprite_filename = slash_sprite_path.get_file().get_basename()  # e.g., "glowsword_blue"

	# Try using the exact filename first (for unique weapons)
	var walk_path = "res://assets/weapons/walk/" + sprite_filename + ".png"
	if ResourceLoader.exists(walk_path):
		print("🚶 Using weapon walk sprite (exact match): ", walk_path)
		return walk_path

	# FALLBACK: Use weapon_type mapping for standard weapons
	# Map weapon types to sprite filenames
	var weapon_sprite_name = weapon_type
	match weapon_type:
		"sword":
			weapon_sprite_name = "longsword"
		"hammer":
			weapon_sprite_name = "waraxe"
		# All others use their weapon_type directly (club, dagger, mace, spear, rapier)

	walk_path = "res://assets/weapons/walk/" + weapon_sprite_name + ".png"

	# Check if file exists, otherwise return empty (no weapon shown while walking)
	if not ResourceLoader.exists(walk_path):
		print("⚠️ Warning: No walk sprite found for weapon '", sprite_filename, "' or type '", weapon_type, "'")
		return ""

	print("🚶 Using weapon walk sprite (type mapping): ", walk_path)
	return walk_path
