# Godot 4+ specific ignores
.godot/
*.uid

# Godot-specific files to ignore
*.import
*.md5
*.translation
.import/
export.cfg
export_presets.cfg
.mono/
data_*/

# Build artifacts
*.exe
*.pck
*.app
*.dmg
*.zip

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Editor-specific files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
*.temp
stderr.txt
stdout.txt
_ul-*

# Backup files
*.bak
*.backup
*.backup_*
*~

# Security - prevent accidental key commits
*.key
*private*key*
*.pem

# User-specific settings (machine-specific, not tracked)
.claude/settings.local*.json
nul

# LPC Generator (external tool - not part of project)
tools/lpc-generator/

# MCP config (machine-specific paths)
.mcp.json

# Temp files
_ul
