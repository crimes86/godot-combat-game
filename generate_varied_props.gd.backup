# generate_varied_props.gd
# Script to generate prop placements with varied sizes
extends Node

# Prop categories with size variations
const ROCK_TYPES = ["rock_small", "rock_medium", "rock_large"]
const TREE_TYPES = ["dead_tree_1", "dead_tree_2"]
const GROUND_DECOR = ["skull", "bones", "ground_crack_1", "ground_crack_2", "broken_sword", "ash_pile"]

# Size multipliers for each rock/tree type
const SIZE_RANGES = {
	"rock_small": {"min": 0.8, "max": 1.4},
	"rock_medium": {"min": 0.9, "max": 1.5},
	"rock_large": {"min": 1.0, "max": 1.8},
	"dead_tree_1": {"min": 0.7, "max": 1.6},
	"dead_tree_2": {"min": 0.8, "max": 1.5}
}

func _ready():
	print("🎨 Generating varied prop placements...")
	generate_props()
	print("✅ Done! Prop placements saved to prop_placements.json")
	get_tree().quit()

func generate_props():
	var props = []
	var prop_id = 0
	
	# Path coordinates (following the path layer)
	var path_y_positions = {
		400: 0, 800: -100, 1200: -200, 1600: -100, 2000: 50,
		2400: 150, 2800: 100, 3200: -100, 3600: -200, 4000: -100,
		4400: 100, 4800: 50, 5200: -50, 5600: 0, 6000: -50,
		6400: 50, 6800: 0, 7200: -50, 7600: 0
	}
	
	# Generate props along the world
	for x in range(600, 7400, 150):  # Every 150 pixels
		var base_y = get_path_y_at_x(x, path_y_positions)
		
		# Scatter props on both sides of the path
		for side in [-1, 1]:  # Left and right of path
			# Distance from path (vary it)
			var distance_from_path = randf_range(200, 500) * side
			var y = base_y + distance_from_path
			
			# Randomly decide what to place
			var rand = randf()
			
			if rand < 0.4:  # 40% chance for rocks
				var rock_type = ROCK_TYPES[randi() % ROCK_TYPES.size()]
				var size_range = SIZE_RANGES[rock_type]
				var scale = randf_range(size_range.min, size_range.max)
				
				props.append({
					"id": prop_id,
					"type": rock_type,
					"x": x + randf_range(-50, 50),
					"y": y + randf_range(-50, 50),
					"scale": scale,
					"rotation": randf() * TAU,
					"flip_h": randf() > 0.5,
					"z_index": -1
				})
				prop_id += 1
				
			elif rand < 0.6:  # 20% chance for trees
				var tree_type = TREE_TYPES[randi() % TREE_TYPES.size()]
				var size_range = SIZE_RANGES[tree_type]
				var scale = randf_range(size_range.min, size_range.max)
				
				props.append({
					"id": prop_id,
					"type": tree_type,
					"x": x + randf_range(-80, 80),
					"y": y + randf_range(-80, 80),
					"scale": scale,
					"rotation": randf() * 0.4 - 0.2,  # Slight tilt
					"flip_h": randf() > 0.5,
					"z_index": -1
				})
				prop_id += 1
				
			elif rand < 0.85:  # 25% chance for ground decor
				var decor_type = GROUND_DECOR[randi() % GROUND_DECOR.size()]
				
				props.append({
					"id": prop_id,
					"type": decor_type,
					"x": x + randf_range(-100, 100),
					"y": y + randf_range(-100, 100),
					"scale": randf_range(0.8, 1.3),
					"rotation": randf() * TAU,
					"flip_h": randf() > 0.5,
					"z_index": -1
				})
				prop_id += 1
	
	# Add some clustered rocks and trees for variety
	add_clusters(props, prop_id)
	
	# Save to JSON
	var data = {"ScatteredProps": props}
	var file = FileAccess.open("res://prop_placements.json", FileAccess.WRITE)
	if file:
		file.store_string(JSON.stringify(data, "\t"))
		file.close()
		print("💾 Saved ", props.size(), " props to prop_placements.json")
	else:
		print("❌ Failed to save prop_placements.json")

func add_clusters(props: Array, start_id: int):
	"""Add clusters of rocks and trees for visual interest"""
	var prop_id = start_id
	
	# Define cluster locations
	var cluster_centers = [
		Vector2(1500, -400),
		Vector2(2800, 300),
		Vector2(4200, -300),
		Vector2(5500, 200),
		Vector2(6800, -200)
	]
	
	for center in cluster_centers:
		# Add 5-8 rocks in a cluster
		var num_rocks = randi() % 4 + 5
		for i in range(num_rocks):
			var rock_type = ROCK_TYPES[randi() % ROCK_TYPES.size()]
			var size_range = SIZE_RANGES[rock_type]
			var offset = Vector2(randf_range(-150, 150), randf_range(-150, 150))
			
			props.append({
				"id": prop_id,
				"type": rock_type,
				"x": center.x + offset.x,
				"y": center.y + offset.y,
				"scale": randf_range(size_range.min, size_range.max),
				"rotation": randf() * TAU,
				"flip_h": randf() > 0.5,
				"z_index": -1
			})
			prop_id += 1
		
		# Add 2-3 trees in the cluster
		var num_trees = randi() % 2 + 2
		for i in range(num_trees):
			var tree_type = TREE_TYPES[randi() % TREE_TYPES.size()]
			var size_range = SIZE_RANGES[tree_type]
			var offset = Vector2(randf_range(-200, 200), randf_range(-200, 200))
			
			props.append({
				"id": prop_id,
				"type": tree_type,
				"x": center.x + offset.x,
				"y": center.y + offset.y,
				"scale": randf_range(size_range.min, size_range.max),
				"rotation": randf() * 0.4 - 0.2,
				"flip_h": randf() > 0.5,
				"z_index": -1
			})
			prop_id += 1

func get_path_y_at_x(x: float, path_points: Dictionary) -> float:
	"""Get interpolated Y position along the path for given X"""
	var keys = path_points.keys()
	keys.sort()
	
	# Find surrounding points
	var prev_x = keys[0]
	var next_x = keys[-1]
	
	for key in keys:
		if key <= x:
			prev_x = key
		if key >= x and next_x == keys[-1]:
			next_x = key
			break
	
	if prev_x == next_x:
		return path_points[prev_x]
	
	# Linear interpolation
	var t = (x - prev_x) / (next_x - prev_x)
	return lerp(path_points[prev_x], path_points[next_x], t)
