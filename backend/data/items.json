  "effect_definitions": {
    "_comment": "Passive and active effect definitions. Power values scale with item rarity (legendary=100%, epic=75%, rare=50%)",

    "passive": {
      "lifesteal": {
        "name": "I Have Never Known Defeat",
        "description": "Heal for {power}% of damage dealt",
        "base_power": 5.0,
        "trigger": "on_hit",
        "native_equivalent": "Vampiric Enchantment"
      },
      "death_prevention": {
        "name": "Erdtree's Embrace",
        "description": "Survive a lethal hit with 1 HP (once per battle)",
        "base_power": 1,
        "trigger": "on_lethal_damage",
        "native_equivalent": "Phoenix Blessing"
      },
      "boss_damage": {
        "name": "Godslayer",
        "description": "+{power}% damage to bosses and elites",
        "base_power": 15.0,
        "trigger": "on_hit_boss",
        "native_equivalent": "Slayer's Mark"
      },
      "crit_chance": {
        "name": "Precise Strike",
        "description": "+{power}% critical hit chance",
        "base_power": 10.0,
        "trigger": "passive",
        "native_equivalent": "Precision Gem"
      },
      "damage_reduction": {
        "name": "Ironclad",
        "description": "Reduce incoming damage by {power}%",
        "base_power": 12.0,
        "trigger": "on_hit_received",
        "native_equivalent": "Iron Will"
      },
      "lightning_proc": {
        "name": "Storm's Fury",
        "description": "{power}% chance to strike with lightning on hit",
        "base_power": 15.0,
        "trigger": "on_hit",
        "native_equivalent": "Lightning Enchantment"
      },
      "fire_aura": {
        "name": "Kindled Soul",
