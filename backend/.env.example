# =============================================================================
# ASHBANE BACKEND CONFIGURATION
# =============================================================================
# Copy this to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# CORE SETTINGS
# =============================================================================

# App URL - your production domain (HTTPS required for OAuth callbacks)
APP_URL=https://your-domain.com

# Session secret - MUST be unique and random for production
# Generate with: openssl rand -hex 32
SESSION_SECRET=generate-a-random-32-char-string-here

# Admin secret - required for admin endpoints in production
# Generate with: openssl rand -hex 16
ADMIN_SECRET=generate-a-secure-admin-secret

# Server API key - for dedicated game server to sync character data
# Generate with: openssl rand -hex 32
SERVER_API_KEY=generate-a-secure-server-api-key

# CORS - comma-separated list of allowed origins for production
# Example: CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS=

# Beta access gate - set to require a code for beta access (optional)
# BETA_ACCESS_CODE=your-beta-code

# Development mode - set to false for production!
# When true: simulates blockchain transactions, enables mock activity
DEV_MODE=false

# =============================================================================
# DATABASE
# =============================================================================

# SQLite for development
# DATABASE_URL=sqlite:///./socialauth.db

# PostgreSQL for production (recommended)
DATABASE_URL=postgresql://ashbane:your_secure_password@localhost:5432/ashbanedb

# =============================================================================
# PROVIDER API KEYS
# =============================================================================

# Steam - https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Battle.net - https://develop.battle.net/
BATTLENET_CLIENT_ID=your_client_id
BATTLENET_CLIENT_SECRET=your_client_secret

# Xbox (via OpenXBL) - https://xbl.io/
OPENXBL_API_KEY=your_openxbl_api_key

# Discord - https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# GitHub - https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Facebook - https://developers.facebook.com/apps
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Roblox - https://create.roblox.com/dashboard/credentials
ROBLOX_CLIENT_ID=your_roblox_client_id
ROBLOX_CLIENT_SECRET=your_roblox_client_secret

# =============================================================================
# BLOCKCHAIN CONFIGURATION (for Forge system)
# =============================================================================

# Chain ID
# Base Sepolia (testnet): 84532
# Base Mainnet: 8453
# Polygon Mainnet: 137
CHAIN_ID=84532

# RPC URL - get from Alchemy (https://alchemy.com) or Infura (https://infura.io)
RPC_URL=https://sepolia.base.org

# Achievement contract address (deploy first, then add address)
ACHIEVEMENT_CONTRACT_ADDRESS=

# Minter wallet - backend wallet that mints forged achievements
# Generate a new wallet, fund with testnet/mainnet ETH for gas
# NEVER use a wallet with real funds on testnet, and vice versa
MINTER_PRIVATE_KEY=

# Platform wallet - custody wallet for bridge system
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_KEY=
