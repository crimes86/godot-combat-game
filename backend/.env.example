# Copy this to .env and fill in your values

# App settings
APP_URL=http://localhost:8000
SESSION_SECRET=generate-a-random-32-char-string-here

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./socialauth.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/socialauth

# Steam API - Get from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Battle.net - Get from https://develop.battle.net/
BATTLENET_CLIENT_ID=your_client_id
BATTLENET_CLIENT_SECRET=your_client_secret

# Xbox - Get from https://portal.azure.com/
# XBOX_CLIENT_ID=your_xbox_client_id
# XBOX_CLIENT_SECRET=your_xbox_client_secret
